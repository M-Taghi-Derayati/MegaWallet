<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base application theme. -->
    <style name="Theme.MegaWallet" parent="android:style/Theme.Material.Light.NoActionBar">

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>

    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <!-- رنگ پس‌زمینه باید دقیقاً با رنگ بک‌گراند انیمیشن یکی باشد -->
        <item name="windowSplashScreenBackground">@color/background</item>

        <!-- قرار دادن لوگوی استاتیکی که قبلاً ساختیم -->
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_screen</item>

        <!-- مدت زمان نمایش (اختیاری) -->
        <item name="windowSplashScreenAnimationDuration">100</item>

        <!-- تم اصلی که بعد از لود شدن باید اعمال شود -->
        <item name="postSplashScreenTheme">@style/Theme.MegaWallet</item>
    </style>
</resources>