<?xml version="1.0" encoding="utf-8"?>
<!--
    RELEASE / default network security config.

    HTTPS-only, and trusts ONLY the system CA store. Cleartext traffic and trust of
    user-installed CAs are permitted exclusively in DEBUG builds, via the build-type
    resource overlay at:  app/src/debug/res/xml/network_security_config.xml
    (which replaces this file in debug builds).

    TASK-01 / TD-34 (was: a plain <base-config> that permitted cleartext + user-CA trust in
    release, enabling MITM of relayed signed transactions and the session JWT).
    Full close-out — relayer TLS + certificate pinning — is tracked as TASK-11 / TD-29/TD-30.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
